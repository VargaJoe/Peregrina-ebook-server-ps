<html>
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"></meta>
        <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.0/css/bootstrap.min.css">
        <link rel="stylesheet" type="text/css" href="/style/peregrina.css"></link>
        <title>pelegrin</title>
    </head>
    <body>
        <header>
            <nav class="nav nav-bar-nav">
                <li><a class="home-btn" href="/"><i class="glyphicon glyphicon-home"></i></a></li>
            </nav>

            <nav class="nav nav-bar-nav nav-bar-right">
                <li><a href="./logout" title="Logout"><i class="glyphicon glyphicon-log-out"></i></a></li>
            </nav>
        </header>
        <section class="placeholder">
            <div id="pdf-container">
                <img id="pdf-image" src="" alt="PDF Page" style="width: 100%;">
                <div style="text-align: center; margin-top: 10px;">
                    <button id="prev-page" disabled>Previous</button>
                    <button id="next-page" disabled>Next</button>
                </div>
            </div>
            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    var imageUrls = JSON.parse('<%$($model.Url)%>');
                    var currentPage = 0;
                    var pdfImage = document.getElementById('pdf-image');
                    var prevButton = document.getElementById('prev-page');
                    var nextButton = document.getElementById('next-page');
    
                    function showPage(page) {
                        pdfImage.src = imageUrls[page];
                        prevButton.disabled = page === 0;
                        nextButton.disabled = page === imageUrls.length - 1;
                    }
    
                    if (imageUrls.length > 0) {
                        showPage(currentPage);
                         nextButton.disabled = imageUrls.length === 1;
                         prevButton.disabled = true;
                    }
                    nextButton.addEventListener('click', function() {
                        showPage(++currentPage);
                    });
                    prevButton.addEventListener('click', function() {
                        showPage(--currentPage);
                    });
                });
            </script>
        </section>    
        <footer><a href="https://github.com/VargaJoe/ePeregrina-server-ps" class="poweredby">powered by ePeregrina</a></footer>
    </body>
</html>
